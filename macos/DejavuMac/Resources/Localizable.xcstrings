    "Floating Overlay options" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "플로팅 오버레이 옵션" } }
      }
    },
    "Overlay visibility is saved. Other overlay options are preview-only." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "오버레이 표시 여부는 저장됩니다. 다른 오버레이 옵션은 미리보기 전용입니다." } }
      }
