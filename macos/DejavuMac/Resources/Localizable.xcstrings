    "Skip" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "건너뛰기" } }
      }
    },
    "Start with sensible defaults. Provider metrics and the optional widget remain under your control." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "권장 기본값으로 시작하세요. 공급자 지표와 선택형 위젯은 언제든 직접 설정할 수 있습니다." } }
      }
    },
    "Status" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "상태" } }
      }
    },
    "Stored locally" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Mac에만 저장" } }
      }
    },
    "System" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "시스템" } }
      }
    },
    "Tokens, authorization headers, and Keychain items are never read or stored." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "토큰, 인증 헤더 및 키체인 항목을 읽거나 저장하지 않습니다." } }
      }
    },
    "Codex credentials are not read. Optional Fable access uses the Claude Code Keychain only after you enable it." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Codex 인증 정보는 읽지 않습니다. 선택형 Fable 접근은 사용자가 켠 뒤에만 Claude Code 키체인을 사용합니다." } }
      }
    },
    "Top right" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "오른쪽 상단" } }
      }
    },
    "Turn the widget on or off at any time in Settings." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "설정에서 언제든 위젯을 켜거나 끌 수 있습니다." } }
      }
    },
    "Use the floating overlay or add Dejavu from the macOS widget gallery." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "플로팅 오버레이를 사용하거나 macOS 위젯 갤러리에서 Dejavu를 추가할 수 있습니다." } }
      }
    },
    "Usage at a glance" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "사용량을 한눈에" } }
      }
    },
    "Usage snapshots remain in your user Application Support directory." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "사용량 스냅샷은 사용자의 Application Support 폴더에만 보관됩니다." } }
      }
    },
    "Usage snapshots stay in your user Application Support directory." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "사용량 스냅샷은 사용자의 Application Support 폴더에만 보관됩니다." } }
      }
    },
    "Uses the local Codex app-server. Dejavu never reads ChatGPT credentials directly." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "로컬 Codex app-server를 사용합니다. Dejavu는 ChatGPT 인증 정보를 직접 읽지 않습니다." } }
