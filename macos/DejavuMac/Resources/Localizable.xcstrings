    "Not connected" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "연결되지 않음" } }
      }
    },
    "One row" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "한 줄" } }
      }
    },
    "One-click access" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "한 번의 클릭으로 열기" } }
      }
    },
    "Onboarding progress" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "시작 안내 진행률" } }
      }
    },
    "Optional floating widget" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "선택형 플로팅 위젯" } }
      }
    },
    "Two optional widgets" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "두 가지 선택형 위젯" } }
      }
    },
    "Placement" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "위치" } }
      }
    },
    "Private by design" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "개인정보 보호 중심 설계" } }
      }
    },
    "Prompts, transcripts, browser content, and working directories are not saved." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "프롬프트, 대화 기록, 브라우저 콘텐츠 및 작업 디렉터리는 저장하지 않습니다." } }
      }
    },
    "Provider connections are not enabled in this preview." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 미리보기에서는 공급자 연결을 사용할 수 없습니다." } }
      }
    },
    "Reads only rate-limit fields supplied by the Claude Code status line. Dejavu never reads Keychain credentials." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code 상태 줄이 제공하는 사용량 제한 필드만 읽습니다. Dejavu는 키체인 인증 정보를 읽지 않습니다." } }
      }
    },
    "Ready" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "준비됨" } }
      }
    },
    "Ready when you are" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "바로 시작할 수 있습니다" } }
      }
    },
    "Refreshing" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "새로고침 중" } }
      }
    },
    "Review how Dejavu shows local usage and protects provider data." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Dejavu가 로컬 사용량을 표시하고 공급자 데이터를 보호하는 방식을 확인합니다." } }
      }
    },
    "See Claude 5h and Codex usage at a glance." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Claude 5h와 Codex 사용량을 한눈에 확인합니다." } }
      }
    },
    "Show Welcome…" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "시작 안내 보기…" } }
