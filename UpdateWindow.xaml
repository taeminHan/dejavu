<Window x:Class="ClaudeUsageTray.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dejavu 업데이트" Width="460" Height="390" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ShowInTaskbar="True"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text" Closing="OnClosing">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14"
            Background="{DynamicResource SurfaceBrush}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid Margin="18,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}">
                            <TextBlock Text="↑" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="dejavu 업데이트" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="CloseButton" Style="{StaticResource GhostButton}" Width="36" Height="36"
                            Padding="0" HorizontalAlignment="Right" ToolTip="닫기" Click="OnLaterClick">
                        <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="26,24,26,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="TitleText" Text="새 버전을 사용할 수 있어요" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionText" Grid.Row="1" Margin="0,7,0,0"
                           Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                <Border Grid.Row="2" Margin="0,18" Padding="15" CornerRadius="10"
                        Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <ScrollViewer Padding="0,0,6,0" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="NotesText" TextWrapping="Wrap" LineHeight="20"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                    </ScrollViewer>
                </Border>
                <StackPanel Grid.Row="3" x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,0,0,16">
                    <Grid Margin="0,0,0,7">
                        <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock x:Name="ProgressText" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}"/>
                    </Grid>
                    <ProgressBar x:Name="DownloadProgress" Style="{StaticResource UpdateProgress}"/>
                </StackPanel>
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="LaterButton" MinWidth="76" Style="{StaticResource GhostButton}" Content="나중에" Click="OnLaterClick"/>
                    <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Content="지금 업데이트"
                            MinWidth="112" Margin="8,0,0,0" Click="OnInstallClick"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
