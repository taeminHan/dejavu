<Window x:Class="ClaudeUsageTray.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Dejavu 설정" Width="920" Height="700" MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource AppFontFamily}"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        StateChanged="OnWindowStateChanged" Closing="OnClosing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="{DynamicResource WindowCornerRadius}"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="Padding" Value="{DynamicResource SettingsRowPadding}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="23" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,22" />
        </Style>
        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="SettingDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
    </Window.Resources>

    <Grid x:Name="WindowSurface" Background="{DynamicResource BackgroundBrush}"
          SnapsToDevicePixels="True">
    <Grid x:Name="SettingsShell" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid.RowDefinitions><RowDefinition x:Name="SettingsTitleRow" Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Rectangle x:Name="SettingsTextureOverlay" Grid.RowSpan="2" IsHitTestVisible="False"
                   Visibility="Collapsed" Opacity="0.12">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,12,12" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="{DynamicResource ThemeGridBrush}" Geometry="M 0,11 L 12,11 12,12 0,12 Z" />
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Border x:Name="SettingsTitleBar" Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="18,0" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="SettingsMark" Width="36" Height="36" Source="{StaticResource DejavuBrandImage}" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="SettingsBrandText" Text="Dejavu" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="SettingsSubtitleText" Text="설정은 자동으로 저장됩니다" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Height="28" VerticalAlignment="Center" Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource BadgeCornerRadius}"
                            Padding="9,0" Margin="0,0,10,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="6"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="SaveStateText" Grid.Column="2" Text="저장됨" FontSize="10" LineHeight="13"
                                       LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </Grid>
                    </Border>
                    <Border Width="1" Height="22" Background="{DynamicResource BorderBrush}" Margin="0,0,6,0" />
                    <Button Style="{StaticResource CaptionButton}" ToolTip="최소화" AutomationProperties.Name="최소화" Click="OnMinimizeClick">
                        <Path Data="M 1,6 L 11,6" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" />
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" ToolTip="최대화 또는 복원" AutomationProperties.Name="최대화 또는 복원" Click="OnMaximizeClick">
                        <Rectangle Width="10" Height="10" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.2" />
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" ToolTip="닫기" AutomationProperties.Name="설정 닫기" Click="OnCloseClick">
                        <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="SettingsBody" Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="SettingsSidebarColumn" Width="176"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="SettingsSidebar" Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0" Padding="12,18">
                <StackPanel x:Name="SettingsNavStack">
                    <TextBlock Text="환경설정" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="12,0,0,12" />
                    <RadioButton x:Name="DisplayNav" Style="{StaticResource NavButton}" IsChecked="True"
                                 Tag="{StaticResource DisplayIconGeometry}" Content="표시" GroupName="SettingsNav" Checked="OnNavigationChanged" />
                    <RadioButton x:Name="AppearanceNav" Style="{StaticResource NavButton}"
                                 Tag="{StaticResource AppearanceIconGeometry}" Content="꾸미기" GroupName="SettingsNav" Checked="OnNavigationChanged" />
                    <RadioButton x:Name="ConnectionsNav" Style="{StaticResource NavButton}"
                                 Tag="{StaticResource ConnectionsIconGeometry}" Content="연결" GroupName="SettingsNav" Checked="OnNavigationChanged" />
                    <RadioButton x:Name="BehaviorNav" Style="{StaticResource NavButton}"
                                 Tag="{StaticResource BehaviorIconGeometry}" Content="동작" GroupName="SettingsNav" Checked="OnNavigationChanged" />
                    <RadioButton x:Name="UpdateNav" Style="{StaticResource NavButton}"
                                 Tag="{StaticResource UpdatesIconGeometry}" Content="업데이트" GroupName="SettingsNav" Checked="OnNavigationChanged" />
                    <RadioButton x:Name="PrivacyNav" Style="{StaticResource NavButton}"
                                 Tag="{StaticResource PrivacyIconGeometry}" Content="개인정보" GroupName="SettingsNav" Checked="OnNavigationChanged" />
                </StackPanel>
            </Border>

            <Grid x:Name="SettingsContent" Grid.Column="1">
                <ScrollViewer x:Name="DisplayPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="표시" />
                        <Border Style="{StaticResource SettingRow}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Style="{StaticResource SettingTitle}" Text="표시할 서비스"/><TextBlock Style="{StaticResource SettingDescription}" Text="자동 감지는 사용 가능한 서비스만 표시합니다"/></StackPanel>
                                <ComboBox Grid.Column="1" VerticalAlignment="Center" x:Name="ServicesCombo" Style="{StaticResource AppComboBox}" Width="190" HorizontalAlignment="Right" SelectionChanged="OnServicesChanged"  AutomationProperties.Name="표시할 서비스" /></Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Style="{StaticResource SettingTitle}" Text="기본 표시 위치"/><TextBlock x:Name="PlacementDescriptionText" Style="{StaticResource SettingDescription}" TextWrapping="Wrap" Text="직접 이동하면 마지막 위치를 기억합니다"/></StackPanel><ComboBox x:Name="PlacementCombo" Grid.Column="1" Style="{StaticResource AppComboBox}" Width="220" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="표시 위치" SelectionChanged="OnPlacementChanged"/></Grid></Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0"><TextBlock Style="{StaticResource SettingTitle}" Text="위젯 크기"/><TextBlock x:Name="DensityDescriptionText" Style="{StaticResource SettingDescription}" TextWrapping="Wrap" Text="작음, 중간, 큼 중 화면에 맞는 밀도를 선택합니다"/></StackPanel>
                                <ComboBox x:Name="DensityCombo" Grid.Column="1" Style="{StaticResource AppComboBox}" Width="190" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="OnDensityChanged"  AutomationProperties.Name="위젯 크기" /></Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0"><TextBlock Style="{StaticResource SettingTitle}" Text="위젯 배치"/><TextBlock x:Name="LayoutDescriptionText" Style="{StaticResource SettingDescription}" TextWrapping="Wrap" Text="두 서비스가 표시될 때만 Codex 위 · Claude 아래로 나눕니다"/></StackPanel>
                                <ComboBox x:Name="LayoutCombo" Grid.Column="1" Style="{StaticResource AppComboBox}" Width="190" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="OnLayoutChanged"  AutomationProperties.Name="서비스별 배치" /></Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Style="{StaticResource SettingTitle}" Text="사용량 그래프"/><TextBlock Style="{StaticResource SettingDescription}" Text="꺼도 퍼센트 숫자는 항상 표시합니다"/></StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="BarsStatus" VerticalAlignment="Center" Margin="0,0,11,0" FontSize="11" FontWeight="SemiBold"/><CheckBox x:Name="BarsToggle" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="프로그레스 바 표시" Checked="OnToggleChanged" Unchecked="OnToggleChanged"/></StackPanel></Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsNote}"><TextBlock Style="{StaticResource SettingDescription}" Text="위젯을 누르면 상세 사용량이 열리고, 끌면 위치를 바꿀 수 있어요. 작업표시줄 안에서는 클릭만 지원합니다." /></Border>
                        <Button Style="{StaticResource AppButton}" HorizontalAlignment="Left" Content="위치 초기화" Click="OnResetPosition" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="ConnectionsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="연결" />
                        <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock x:Name="ClaudeConnectionTitle" TextWrapping="Wrap" FontWeight="SemiBold" Text="Claude 연결 확인 중" />
                                    <TextBlock x:Name="ClaudeConnectionDescription" Margin="0,7,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Text="사용 가능한 Claude 사용량 항목을 확인합니다." />
                                </StackPanel>
                                <Button x:Name="ClaudeConnectionButton" Style="{StaticResource AppButton}"
                                        HorizontalAlignment="Left"
                                        Content="Claude Code 로그인" Click="OnClaudeLoginClick" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock x:Name="CodexConnectionTitle" TextWrapping="Wrap" FontWeight="SemiBold" Text="Codex 연결 확인 중" />
                                    <TextBlock x:Name="CodexConnectionDescription" Margin="0,7,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Text="Codex Desktop과 CLI에서 사용할 수 있는 로컬 런타임을 확인합니다." />
                                </StackPanel>
                                <Button x:Name="CodexConnectionButton" Style="{StaticResource AppButton}"
                                        HorizontalAlignment="Left"
                                        Content="Codex 로그인" Click="OnCodexLoginClick" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsNote}"><TextBlock Style="{StaticResource SettingDescription}" Text="Dejavu 계정은 필요하지 않습니다. 연결 버튼은 제공사의 로그인 또는 설치 화면을 엽니다. Claude Desktop만 연결하면 Fable과 초기화 시각은 제공되지 않습니다." /></Border>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="AppearancePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="꾸미기" />

                        <Border Style="{StaticResource SettingRow}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Style="{StaticResource SettingTitle}" Text="색상 모드"/><TextBlock Style="{StaticResource SettingDescription}" Text="Windows 설정을 따르거나 테마를 고정합니다"/></StackPanel>
                                <ComboBox Grid.Column="1" VerticalAlignment="Center" x:Name="ThemeCombo" Style="{StaticResource AppComboBox}" Width="190" HorizontalAlignment="Right" SelectionChanged="OnThemeChanged"  AutomationProperties.Name="색상 모드" /></Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Style="{StaticResource SettingTitle}" Text="테마"/><TextBlock x:Name="ThemeDescriptionText" Style="{StaticResource SettingDescription}" TextWrapping="Wrap" Text="위젯과 앱 화면에 적용됩니다"/></StackPanel>
                                <ComboBox Grid.Column="1" VerticalAlignment="Center" x:Name="WidgetThemeCombo" Style="{StaticResource AppComboBox}" Width="220" HorizontalAlignment="Right" SelectionChanged="OnWidgetThemeChanged"  AutomationProperties.Name="테마" /></Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Style="{StaticResource SettingTitle}" Text="배경 불투명도"/><TextBlock x:Name="OpacityDescriptionText" Style="{StaticResource SettingDescription}" Text="값이 낮을수록 배경만 투명해집니다. 글자와 그래프는 선명하게 유지합니다"/></StackPanel>
                                <StackPanel Grid.Column="1" Width="210" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="OpacityValue" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}"/><Slider x:Name="OpacitySlider" Minimum="55" Maximum="100" ValueChanged="OnOpacityChanged" /></StackPanel></Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Style="{StaticResource SettingTitle}" Text="강조 색상"/><TextBlock Style="{StaticResource SettingDescription}" Text="진행률과 활성 상태에 사용할 색상입니다"/></StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <RadioButton x:Name="BlueAccent" Style="{StaticResource ColorSwatchButton}" GroupName="AccentColors"
                                                 Background="#6D8EFF" Tag="#6D8EFF" ToolTip="블루" AutomationProperties.Name="강조 색상 블루" Checked="OnAccentChanged" />
                                    <RadioButton x:Name="PurpleAccent" Style="{StaticResource ColorSwatchButton}" GroupName="AccentColors"
                                                 Background="#8B7CF6" Tag="#8B7CF6" ToolTip="퍼플" AutomationProperties.Name="강조 색상 퍼플" Checked="OnAccentChanged" />
                                    <RadioButton x:Name="CoralAccent" Style="{StaticResource ColorSwatchButton}" GroupName="AccentColors"
                                                 Background="#D97757" Tag="#D97757" ToolTip="코랄" AutomationProperties.Name="강조 색상 코랄" Checked="OnAccentChanged" />
                                    <RadioButton x:Name="GreenAccent" Style="{StaticResource ColorSwatchButton}" GroupName="AccentColors"
                                                 Background="#2BA37A" Tag="#2BA37A" ToolTip="그린" AutomationProperties.Name="강조 색상 그린" Checked="OnAccentChanged" />
                                </StackPanel></Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="BehaviorPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="동작" />

                        <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Style="{StaticResource SettingTitle}" Text="자동 갱신"/><TextBlock Style="{StaticResource SettingDescription}" Text="요청 제한 시에는 자동으로 간격을 늘립니다"/></StackPanel><ComboBox Grid.Column="1" VerticalAlignment="Center" x:Name="RefreshCombo" Style="{StaticResource AppComboBox}" Width="190" HorizontalAlignment="Right" SelectionChanged="OnRefreshChanged" AutomationProperties.Name="사용량 자동 갱신 간격" /></Grid></Border>
                        <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Style="{StaticResource SettingTitle}" Text="트레이 아이콘"/><TextBlock Style="{StaticResource SettingDescription}" Text="아이콘을 숨겨도 상시 위젯은 유지됩니다"/></StackPanel><ComboBox Grid.Column="1" VerticalAlignment="Center" x:Name="TrayCombo" Style="{StaticResource AppComboBox}" Width="220" HorizontalAlignment="Right" SelectionChanged="OnTrayChanged" AutomationProperties.Name="트레이 아이콘" /></Grid></Border>
                        <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Style="{StaticResource SettingTitle}" Text="Windows 시작 시 실행"/><TextBlock Style="{StaticResource SettingDescription}" Text="로그인 후 위젯을 자동으로 표시합니다"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="StartupStatus" VerticalAlignment="Center" Margin="0,0,11,0" FontSize="11" FontWeight="SemiBold"/><CheckBox x:Name="StartupToggle" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="Windows 시작 시 실행" Checked="OnStartupChanged" Unchecked="OnStartupChanged"/></StackPanel></Grid></Border>
                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">

                            <Button Style="{StaticResource GhostButton}" Content="모든 설정 기본값 복원" Margin="8,0,0,0" Click="OnRestoreDefaults" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="UpdatePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="업데이트" />
                        <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,14">
                            <Grid>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="현재 버전" />
                                    <TextBlock x:Name="CurrentVersionText" Margin="0,7,0,0" FontSize="20" FontWeight="SemiBold" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,6"
                                        CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
                                    <TextBlock x:Name="UpdateChannelText" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Style="{StaticResource SettingTitle}" Text="자동 업데이트 확인"/><TextBlock Style="{StaticResource SettingDescription}" Text="앱 시작 후와 매 정각 새 버전을 확인합니다"/></StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="UpdateToggleStatus" VerticalAlignment="Center" Margin="0,0,11,0" FontSize="11" FontWeight="SemiBold"/>
                                    <CheckBox x:Name="UpdateToggle" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="자동 업데이트 확인" Checked="OnUpdateToggleChanged" Unchecked="OnUpdateToggleChanged"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                            <StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="수동 확인"/>
                                    <TextBlock x:Name="UpdateCheckStatus" Style="{StaticResource SettingDescription}" AutomationProperties.LiveSetting="Polite" Text="아직 확인하지 않았습니다."/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
                                    <ProgressBar x:Name="UpdateCheckProgress" Style="{StaticResource IndeterminateProgress}"
                                                 Margin="0,0,12,0" IsIndeterminate="True" Visibility="Collapsed" />
                                    <Button x:Name="CheckUpdatesButton" Style="{StaticResource AppButton}" Content="업데이트 확인" Click="OnCheckUpdates"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="PrivacyPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="개인정보" />

                        <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Anthropic 공식 로그인" />
                                <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           Text="연결 버튼은 Anthropic이 제공하는 공식 Claude Code 로그인 화면을 엽니다. dejavu 계정을 만들거나 비밀번호를 받지 않습니다. 사용량 요청에 필요한 토큰은 메모리에서만 일시적으로 읽으며 토큰, 대화 내용, 프롬프트는 저장하거나 진단 파일에 기록하지 않습니다." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="공식 Codex 로컬 인터페이스" />
                                <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           Text="Codex Desktop에 포함된 런타임 또는 별도로 설치된 CLI의 공식 app-server에서 사용률, 초기화 시각, 초기화권 개수와 만료 시각만 읽습니다. CLI를 직접 사용하는 사람일 필요는 없으며 초기화권은 dejavu가 자동으로 사용하지 않습니다." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="현재 연동 상태" />
                                <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"
                                           Text="Claude Code 사용량 경로와 Claude Desktop의 로컬 기록 형식은 외부 앱용 공식 연동 계약이 아닙니다. Desktop 기록에는 초기화 시각과 Fable 사용률이 없어 해당 값은 표시되지 않으며, Claude 업데이트에 따라 연동이 중단될 수 있습니다." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Style="{StaticResource SettingTitle}" Text="진단 상태 파일"/><TextBlock Style="{StaticResource SettingDescription}" Text="토큰 없이 상태와 위젯 위치만 로컬에 기록합니다"/></StackPanel><Button Grid.Column="1" Style="{StaticResource AppButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Content="폴더 열기" Click="OnOpenDiagnostics"/></Grid></Border>
                        <TextBlock Margin="0,20,0,4" Text="dejavu" FontWeight="SemiBold" />
                        <TextBlock x:Name="AboutVersionText" Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
    <Border x:Name="WindowFrame" Panel.ZIndex="100" IsHitTestVisible="False"
            Background="Transparent" BorderBrush="{DynamicResource WindowFrameBrush}"
            BorderThickness="{DynamicResource WindowFrameThickness}"
            CornerRadius="{DynamicResource WindowCornerRadius}"
            SnapsToDevicePixels="True" />
    </Grid>
</Window>
