<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ClaudeUsageTray"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <SolidColorBrush x:Key="BackgroundBrush" Color="#101012" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#18181B" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#202024" />
    <SolidColorBrush x:Key="BorderBrush" Color="#303036" />
    <SolidColorBrush x:Key="WindowFrameBrush" Color="#3A3A42" />
    <SolidColorBrush x:Key="TextBrush" Color="#F7F7F8" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#A1A1AA" />
    <SolidColorBrush x:Key="AccentBrush" Color="#6D8EFF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#25304F" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F07178" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E6A756" />
    <SolidColorBrush x:Key="WidgetBackgroundBrush" Color="#18181B" />
    <SolidColorBrush x:Key="WidgetChromeBrush" Color="#E618181B" />
    <SolidColorBrush x:Key="WidgetChromeRaisedBrush" Color="#E6202024" />
    <SolidColorBrush x:Key="WidgetAccentBrush" Color="#6D8EFF" />
    <SolidColorBrush x:Key="WidgetBorderBrush" Color="#303036" />
    <SolidColorBrush x:Key="WidgetTextBrush" Color="#F7F7F8" />
    <SolidColorBrush x:Key="WidgetMutedTextBrush" Color="#A1A1AA" />
    <SolidColorBrush x:Key="WidgetMetricTextBrush" Color="#6D8EFF" />
    <SolidColorBrush x:Key="WidgetTrackBrush" Color="#202024" />
    <SolidColorBrush x:Key="ThemeGridBrush" Color="#29292E" />
    <SolidColorBrush x:Key="OrbitSunBrush" Color="#F6B93B" />
    <SolidColorBrush x:Key="OrbitSunCoreBrush" Color="#FFF2A8" />
    <SolidColorBrush x:Key="OrbitEarthBrush" Color="#4AA3F2" />
    <SolidColorBrush x:Key="OrbitEarthLandBrush" Color="#78D69B" />
    <SolidColorBrush x:Key="OrbitMoonBrush" Color="#DCE5EE" />
    <SolidColorBrush x:Key="OrbitMoonDetailBrush" Color="#8797AA" />
    <SolidColorBrush x:Key="OrbitSaturnBrush" Color="#E5BF65" />
    <SolidColorBrush x:Key="OrbitSaturnBandBrush" Color="#A8753F" />
    <SolidColorBrush x:Key="OrbitSaturnRingBrush" Color="#DCE5F2" />
    <SolidColorBrush x:Key="OrbitBodyOutlineBrush" Color="#18324F" />
    <!-- In-taskbar overlay defaults (dark taskbar). ThemeManager.ApplyTaskbarPalette
         replaces them from the taskbar's own light/dark and high-contrast state. -->
    <SolidColorBrush x:Key="TaskbarTextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TaskbarMutedTextBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="TaskbarTrackBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="TaskbarAccentBrush" Color="#6D8EFF" />
    <SolidColorBrush x:Key="TaskbarWarningBrush" Color="#FFFCE100" />
    <SolidColorBrush x:Key="TaskbarDangerBrush" Color="#FFFF99A4" />
    <!-- Alpha 1/255 keeps the whole overlay hit-testable while the taskbar shows through. -->
    <SolidColorBrush x:Key="TaskbarSurfaceBrush" Color="#01000000" />
    <SolidColorBrush x:Key="TaskbarHoverBrush" Color="#14FFFFFF" />
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text</FontFamily>
    <FontFamily x:Key="WidgetFontFamily">Segoe UI Variable Text</FontFamily>
    <FontFamily x:Key="TaskbarFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <CornerRadius x:Key="WindowCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="BadgeCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ProgressCornerRadius">2</CornerRadius>
    <Thickness x:Key="WindowFrameThickness">1</Thickness>
    <Thickness x:Key="CardBorderThickness">1</Thickness>
    <Thickness x:Key="SettingsRowPadding">0,15</Thickness>
    <sys:Double x:Key="UsageProgressHeight">4</sys:Double>
    <sys:String x:Key="ThemeMarkText">◒</sys:String>
    <sys:Boolean x:Key="RetroPixelEnabled">False</sys:Boolean>
    <SolidColorBrush x:Key="RetroHighlightBrush" Color="#88FFFFFF" />

    <!-- Familiar Paradox identity: matches design/prototype/brand-mark.svg.
         Fixed brand colors deliberately do not follow the user's accent. -->
    <DrawingImage x:Key="DejavuBrandImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#DDE2D2">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="1,1,62,62" RadiusX="15" RadiusY="15" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <DrawingGroup Transform="0.72,0,0,0.72,9,9">
                    <GeometryDrawing Brush="#203E2E" Geometry="M8,8 H48 V17 H17 Z M48,17 H57 V55 L48,46 Z M17,46 H48 L57,55 H17 Z" />
                    <GeometryDrawing Brush="#97A789" Geometry="M8,8 L17,17 V47 L8,38 Z M48,8 L57,17 H48 Z M8,38 L17,47 V55 L8,46 Z" />
                </DrawingGroup>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <!-- Original action geometry, separate from product/provider identities. -->
    <Geometry x:Key="DisplayIconGeometry">M5,4 H19 A2,2 0 0 1 21,6 V15 A2,2 0 0 1 19,17 H5 A2,2 0 0 1 3,15 V6 A2,2 0 0 1 5,4 M9,21 H15 M12,17 V21</Geometry>
    <Geometry x:Key="AppearanceIconGeometry">M12,3 A9,9 0 1 0 12,21 H13 A2,2 0 0 0 14.6,17.8 A1.5,1.5 0 0 1 15.8,15.4 H18 A3,3 0 0 0 21,12 A9,9 0 0 0 12,3 Z M7.5,10.2 A.8,.8 0 1 0 7.5,11.8 A.8,.8 0 1 0 7.5,10.2 M10,6.7 A.8,.8 0 1 0 10,8.3 A.8,.8 0 1 0 10,6.7 M14.5,6.7 A.8,.8 0 1 0 14.5,8.3 A.8,.8 0 1 0 14.5,6.7 M17,10.2 A.8,.8 0 1 0 17,11.8 A.8,.8 0 1 0 17,10.2</Geometry>
    <Geometry x:Key="ConnectionsIconGeometry">M10,14 L14,10 M8.5,15.5 L7.5,16.5 A3.5,3.5 0 0 1 2.5,11.5 L6.5,7.5 A3.5,3.5 0 0 1 11.5,7.5 M15.5,8.5 L16.5,7.5 A3.5,3.5 0 0 1 21.5,12.5 L17.5,16.5 A3.5,3.5 0 0 1 12.5,16.5</Geometry>
    <Geometry x:Key="BehaviorIconGeometry">M4,7 H8 M12,7 H20 M4,17 H12 M16,17 H20 M10,5 A2,2 0 1 0 10,9 A2,2 0 1 0 10,5 M14,15 A2,2 0 1 0 14,19 A2,2 0 1 0 14,15</Geometry>
    <Geometry x:Key="UpdatesIconGeometry">M12,3 A9,9 0 1 0 12,21 A9,9 0 1 0 12,3 M12,16 V8 M8,12 L12,8 16,12</Geometry>
    <Geometry x:Key="PrivacyIconGeometry">M12,3 L20,6 V12 C20,17 12,21 12,21 C12,21 4,17 4,12 V6 Z M8.5,12 L11,14.5 15.5,9.5</Geometry>

    <Style x:Key="SectionKicker" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,0,0,9" />
    </Style>
    <Style x:Key="SettingsNote" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,18,0,18" />
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="{x:Type local:RetroPixelText}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="PixelEnabled" Value="{DynamicResource RetroPixelEnabled}" />
    </Style>

    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style x:Key="AppButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}" Padding="{TemplateBinding Padding}"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PrimaryChrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}" Padding="{TemplateBinding Padding}"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PrimaryChrome" Property="Opacity" Value="0.88" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="PrimaryChrome" Property="Opacity" Value="0.7" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PrimaryChrome" Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="WidgetCardModern" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WidgetChromeBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WidgetBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource CardBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
    </Style>

    <Style x:Key="WidgetCardRetroNight" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WidgetChromeBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="WidgetCardFluentGlass" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WidgetChromeBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WidgetBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.28" Color="#101827" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WidgetCardTerminalMono" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WidgetChromeBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WidgetBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="WidgetCardOrbit" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WidgetChromeBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WidgetBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.24" Color="#071120" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WidgetCardPaperInk" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WidgetChromeBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WidgetBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- In-taskbar overlay: blends into the taskbar instead of drawing widget chrome.
         No border or shadow; hover uses the shell's subtle highlight. -->
    <Style x:Key="WidgetCardTaskbar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource TaskbarSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TaskbarHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ColorSwatchButton" TargetType="RadioButton">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Width="42" Height="42">
                        <Border x:Name="Chrome" CornerRadius="11" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="2" />
                        <Ellipse x:Name="Swatch" Width="24" Height="24"
                                 Fill="{TemplateBinding Background}" />
                        <Border x:Name="CheckBadge" Width="15" Height="15" CornerRadius="8"
                                Background="{DynamicResource TextBrush}" BorderBrush="{DynamicResource SurfaceBrush}"
                                BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,2,2" Visibility="Collapsed">
                            <Path Data="M 2,4 L 4,6 L 8,2" Stroke="{DynamicResource BackgroundBrush}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                            <Setter TargetName="Swatch" Property="Width" Value="27" />
                            <Setter TargetName="Swatch" Property="Height" Value="27" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="CheckBadge" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollRepeatButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VerticalScrollThumb" TargetType="Thumb">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbChrome" Width="8" Margin="0,2" HorizontalAlignment="Center"
                            Background="{DynamicResource MutedTextBrush}" Opacity="0.62" CornerRadius="{DynamicResource ControlCornerRadius}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbChrome" Property="Width" Value="10" />
                            <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="ThumbChrome" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbChrome" Property="Width" Value="10" />
                            <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="ThumbChrome" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="14" />
        <Setter Property="MinWidth" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollRepeatButton}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource VerticalScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollRepeatButton}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}"
                            BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <ContentPresenter Grid.Column="2" VerticalAlignment="Center" RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="3,2" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemChrome" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource ControlCornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource AppComboBoxItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="TriggerChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid>
                                <ContentPresenter Margin="12,0,36,0" VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}" />
                                <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource MutedTextBrush}"
                                      StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Margin="0,0,13,0" />
                                <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                            <Border Margin="0,6,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="300" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CardCornerRadius}"
                                    Padding="5">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TriggerChrome" Property="BorderBrush" Value="{DynamicResource MutedTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="TriggerChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="TriggerChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="TriggerChrome" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="46" Height="28" Background="Transparent">
                        <Border x:Name="FocusRing" Margin="-3" CornerRadius="{DynamicResource BadgeCornerRadius}"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" Opacity="0" />
                        <Border x:Name="Track" Height="26" VerticalAlignment="Center"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource MutedTextBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource BadgeCornerRadius}" />
                        <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="{DynamicResource TextBrush}"
                                 HorizontalAlignment="Left" Margin="3,0,0,0" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="ThumbTransform" X="0" />
                            </Ellipse.RenderTransform>
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.24" Color="#000000" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="White" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                         Storyboard.TargetProperty="X" To="20" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                         Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="0.42" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Thumb" Property="Width" Value="22" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.45" />
                            <Setter TargetName="Thumb" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderFilledTrack" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4" VerticalAlignment="Center" Background="{DynamicResource AccentBrush}"
                            CornerRadius="{DynamicResource ProgressCornerRadius}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderEmptyTrack" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4" VerticalAlignment="Center" Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Width" Value="17" />
        <Setter Property="Height" Value="17" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbChrome" Background="{DynamicResource TextBrush}"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3"
                            CornerRadius="{DynamicResource BadgeCornerRadius}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbChrome" Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Height" Value="26" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Border Height="4" Margin="8,0" VerticalAlignment="Center"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ProgressCornerRadius}" />
                        <Track x:Name="PART_Track" Margin="8,0">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderFilledTrack}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb Style="{StaticResource SliderThumb}" /></Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderEmptyTrack}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="UsageProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="{DynamicResource UsageProgressHeight}" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="PART_Track" ClipToBounds="True">
                        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ProgressCornerRadius}" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                HorizontalAlignment="Left" CornerRadius="{DynamicResource ProgressCornerRadius}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RetroUsageProgress" TargetType="{x:Type local:UsageProgressBar}">
        <Setter Property="Height" Value="8" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Foreground" Value="{DynamicResource WidgetAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource WidgetTrackBrush}" />
        <Setter Property="local:UsageProgressBar.VisualMode" Value="Pixel" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:UsageProgressBar}">
                    <local:UsageProgressRenderer Value="{TemplateBinding Value}"
                                                 Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                                 VisualMode="Pixel" Fill="{TemplateBinding Foreground}"
                                                 Track="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassUsageProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Foreground" Value="{DynamicResource WidgetAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource WidgetTrackBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6"
                            BorderBrush="{DynamicResource WidgetBorderBrush}" BorderThickness="1" Padding="1">
                        <Grid x:Name="PART_Track" ClipToBounds="True">
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left" CornerRadius="5" Opacity="0.96" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TerminalUsageProgress" TargetType="{x:Type local:UsageProgressBar}">
        <Setter Property="Height" Value="16" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Foreground" Value="{DynamicResource WidgetAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource WidgetMutedTextBrush}" />
        <Setter Property="local:UsageProgressBar.VisualMode" Value="Terminal" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:UsageProgressBar}">
                    <local:UsageProgressRenderer Value="{TemplateBinding Value}"
                                                 Minimum="{TemplateBinding Minimum}"
                                                 Maximum="{TemplateBinding Maximum}"
                                                 VisualMode="{TemplateBinding VisualMode}"
                                                 Fill="{TemplateBinding Foreground}"
                                                 Track="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OrbitUsageProgress" TargetType="{x:Type local:UsageProgressBar}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Foreground" Value="{DynamicResource WidgetAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource WidgetTrackBrush}" />
        <Setter Property="local:UsageProgressBar.VisualMode" Value="Orbit" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:UsageProgressBar}">
                    <local:UsageProgressRenderer Value="{TemplateBinding Value}"
                                                 Minimum="{TemplateBinding Minimum}"
                                                 Maximum="{TemplateBinding Maximum}"
                                                 VisualMode="{TemplateBinding VisualMode}"
                                                 OrbitBody="{TemplateBinding OrbitBody}"
                                                 Fill="{TemplateBinding Foreground}"
                                                 Track="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InkUsageProgress" TargetType="{x:Type local:UsageProgressBar}">
        <Setter Property="Height" Value="12" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Foreground" Value="{DynamicResource WidgetAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource WidgetTrackBrush}" />
        <Setter Property="local:UsageProgressBar.VisualMode" Value="Pencil" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:UsageProgressBar}">
                    <local:UsageProgressRenderer Value="{TemplateBinding Value}"
                                                 Minimum="{TemplateBinding Minimum}"
                                                 Maximum="{TemplateBinding Maximum}"
                                                 VisualMode="{TemplateBinding VisualMode}"
                                                 Fill="{TemplateBinding Foreground}"
                                                 Track="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Height and margins are applied from TaskbarLayoutMetrics; 3 is only the default. -->
    <Style x:Key="TaskbarUsageProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="3" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Foreground" Value="{DynamicResource TaskbarAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource TaskbarTrackBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="PART_Track" ClipToBounds="True">
                        <Border Background="{TemplateBinding Background}" CornerRadius="1.5" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                HorizontalAlignment="Left" CornerRadius="1.5" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="UpdateProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="{DynamicResource UsageProgressHeight}" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="{DynamicResource ProgressCornerRadius}" Padding="1">
                        <Grid x:Name="PART_Track" ClipToBounds="True">
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left" CornerRadius="{DynamicResource ProgressCornerRadius}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IndeterminateProgress" TargetType="ProgressBar">
        <Setter Property="Width" Value="58" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                        <Grid ClipToBounds="True">
                            <Border x:Name="Loader" Width="22" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="3">
                                <Border.RenderTransform><TranslateTransform X="-22" /></Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded" SourceName="Loader">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="Loader"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                     From="-22" To="62" Duration="0:0:0.9" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Loader" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <SolidColorBrush x:Key="OrbitMoonProgressBrush" Color="#B4C4D9" />
    <SolidColorBrush x:Key="OrbitEarthProgressBrush" Color="#65B5FF" />
    <SolidColorBrush x:Key="OrbitSunProgressBrush" Color="#F6B93B" />
    <SolidColorBrush x:Key="OrbitSaturnProgressBrush" Color="#E5BF65" />
    <SolidColorBrush x:Key="OrbitMarsBrush" Color="#E68155" />
    <SolidColorBrush x:Key="OrbitMarsDetailBrush" Color="#A94632" />
    <SolidColorBrush x:Key="OrbitVenusBrush" Color="#F6DFAC" />
    <SolidColorBrush x:Key="OrbitVenusBandBrush" Color="#BA8B3C" />
    <SolidColorBrush x:Key="OrbitJupiterBrush" Color="#F0D4AB" />
    <SolidColorBrush x:Key="OrbitJupiterBandBrush" Color="#AC7046" />
    <SolidColorBrush x:Key="OrbitMarsProgressBrush" Color="#FF9875" />
    <SolidColorBrush x:Key="OrbitVenusProgressBrush" Color="#EAC16A" />
    <SolidColorBrush x:Key="OrbitJupiterProgressBrush" Color="#DCAA7E" />
    <Style x:Key="OrbitSystemCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <!-- Shared typography for the Orbit system and its numeric legend. -->
    <Style x:Key="OrbitLegendText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style x:Key="OrbitProviderText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="OrbitValueText" TargetType="TextBlock" BasedOn="{StaticResource OrbitProviderText}" />
</ResourceDictionary>
