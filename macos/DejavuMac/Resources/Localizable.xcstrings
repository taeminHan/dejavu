{
  "sourceLanguage" : "en",
  "strings" : {
    "120 seconds" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "120초" } }
      }
    },
    "Automatic" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "자동" } }
      }
    },
    "Automatically check for updates" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "자동으로 업데이트 확인" } }
      }
    },
    "Automatic checks run at startup and the next local clock hour. Downloads are verified before installation." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "앱 시작 시와 다음 로컬 정각에 자동으로 확인합니다. 다운로드는 설치 전에 검증됩니다." } }
      }
    },
    "Automatic updates will be available after the native app lifecycle is validated." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "네이티브 앱 수명 주기 검증이 완료되면 자동 업데이트를 사용할 수 있습니다." } }
      }
    },
    "Choose the 5h, weekly, Fable, or hidden menu bar metric in Settings." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "설정에서 메뉴 막대 지표를 5h, 주간, Fable 또는 숨김으로 선택할 수 있습니다." } }
      }
    },
    "Show Codex usage in the menu bar, or hide it." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "메뉴 막대에 Codex 사용량을 표시하거나 숨길 수 있습니다." } }
      }
    },
    "Click the menu bar item to open details and controls." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "메뉴 막대 항목을 클릭하면 상세 정보와 제어 항목이 열립니다." } }
      }
    },
    "Click the menu bar item to open the standard Dejavu menu." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "메뉴 막대 항목을 클릭하면 표준 Dejavu 메뉴가 열립니다." } }
      }
    },
    "Compact" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "컴팩트" } }
      }
    },
    "Data on this Mac" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 Mac의 데이터" } }
      }
    },
    "Dejavu has no server and does not send your usage data to us." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Dejavu는 별도 서버를 운영하지 않으며 사용량 데이터를 전송하지 않습니다." } }
      }
    },
    "Dejavu is a native menu bar companion for local Claude and Codex usage." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Dejavu는 로컬 Claude와 Codex 사용량을 보여주는 Mac 네이티브 메뉴 막대 앱입니다." } }
      }
    },
    "Local usage snapshots" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "로컬 사용량 스냅샷" } }
      }
    },
    "Login item support will be available after the native app lifecycle is validated." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "네이티브 앱 수명 주기 검증이 완료되면 로그인 항목을 지원합니다." } }
      }
    },
    "Menu bar summary" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "메뉴 막대 요약" } }
      }
    },
    "Menu bar metrics and widget visibility are saved. Other widget options are preview-only." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "메뉴 막대 지표와 위젯 표시 여부는 저장됩니다. 그 밖의 위젯 옵션은 미리보기 전용입니다." } }
      }
    },
    "No conversations" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "대화 내용 수집 안 함" } }
      }
    },
    "No provider credentials" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "공급자 인증 정보 수집 안 함" } }
      }
    },
    "Credentials are never stored" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "인증 정보 저장 안 함" } }
      }
    },
    "Not checked" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "확인하지 않음" } }
      }
