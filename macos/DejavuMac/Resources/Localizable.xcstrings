    "Software updates" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "소프트웨어 업데이트" } }
      }
    },
    "Update signing must be configured for this build." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 빌드에는 업데이트 서명 설정이 필요합니다." } }
      }
