<Window x:Class="ClaudeUsageTray.UsageWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dejavu Widget" Width="452" Height="46" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" ResizeMode="NoResize">
    <Border x:Name="WidgetCard" Style="{StaticResource CardBorder}" CornerRadius="14" Padding="14,11"
            MouseLeftButtonDown="OnWidgetMouseDown" MouseRightButtonUp="OnWidgetRightClick">
        <Grid>
            <Grid x:Name="CompactPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="CompactStatusColumn" Width="14" />
                    <ColumnDefinition x:Name="CompactClaudeFiveColumn" Width="*" />
                    <ColumnDefinition x:Name="CompactClaudeGapOne" Width="10" />
                    <ColumnDefinition x:Name="CompactClaudeWeeklyColumn" Width="*" />
                    <ColumnDefinition x:Name="CompactClaudeGapTwo" Width="10" />
                    <ColumnDefinition x:Name="CompactClaudeFableColumn" Width="*" />
                    <ColumnDefinition x:Name="CompactProviderGap" Width="10" />
                    <ColumnDefinition x:Name="CompactCodexColumn" Width="1.35*" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="CompactStatusDot" Width="6" Height="6" HorizontalAlignment="Left"
                         VerticalAlignment="Center" Fill="{DynamicResource AccentBrush}" />
                <StackPanel x:Name="CompactClaudeFivePanel" Grid.Column="1">
                    <Grid><TextBlock Text="5H" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="CompactFiveHourValue" Text="--%" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/></Grid>
                    <ProgressBar x:Name="CompactFiveHourBar" Style="{StaticResource UsageProgress}" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel x:Name="CompactClaudeWeeklyPanel" Grid.Column="3">
                    <Grid><TextBlock Text="주간" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="CompactWeeklyValue" Text="--%" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/></Grid>
                    <ProgressBar x:Name="CompactWeeklyBar" Style="{StaticResource UsageProgress}" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel x:Name="CompactClaudeFablePanel" Grid.Column="5">
                    <Grid><TextBlock Text="Fable" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="CompactFableValue" Text="--%" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/></Grid>
                    <ProgressBar x:Name="CompactFableBar" Style="{StaticResource UsageProgress}" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel x:Name="CompactCodexPanel" Grid.Column="7">
                    <Grid>
                        <TextBlock Text="Codex" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock x:Name="CompactCodexValue" Text="--%" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ProgressBar x:Name="CompactCodexBar" Style="{StaticResource UsageProgress}"/>
                        <TextBlock x:Name="CompactCodexCredits" Grid.Column="1" Text="" Margin="6,-4,0,0" FontSize="9" Foreground="{DynamicResource MutedTextBrush}"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid x:Name="CompactMessagePanel" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="CompactMessageDot" Width="6" Height="6" Margin="0,0,8,0" Fill="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="CompactMessageText" FontSize="11" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="ComfortablePanel" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition x:Name="HeaderRow" Height="18"/><RowDefinition x:Name="CodexRow" Height="Auto"/><RowDefinition x:Name="ClaudeRow" Height="Auto"/></Grid.RowDefinitions>
                <Grid x:Name="HeaderPanel">
                    <TextBlock Text="dejavu" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Top"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Margin="0,4,7,0" Fill="{DynamicResource AccentBrush}"/>
                        <TextBlock x:Name="HeaderStatus" Text="확인 중" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                    </StackPanel>
                </Grid>
                <Grid x:Name="CodexPanel" Grid.Row="1" Margin="0,7,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Codex 주간" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock x:Name="CodexValue" Grid.Column="1" Text="--%" FontSize="12" FontWeight="SemiBold"/>
                    <ProgressBar x:Name="CodexBar" Grid.Column="2" Style="{StaticResource UsageProgress}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CodexCredits" Grid.Column="3" Margin="10,0,0,0" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"/>
                </Grid>
                <Grid x:Name="MetricsPanel" Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"><Grid><TextBlock Text="5시간" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="FiveHourValue" Text="--%" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold"/></Grid><ProgressBar x:Name="FiveHourBar" Style="{StaticResource UsageProgress}" Margin="0,7,0,0"/></StackPanel>
                    <StackPanel Grid.Column="2"><Grid><TextBlock Text="주간 전체" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="WeeklyValue" Text="--%" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold"/></Grid><ProgressBar x:Name="WeeklyBar" Style="{StaticResource UsageProgress}" Margin="0,7,0,0"/></StackPanel>
                    <StackPanel Grid.Column="4"><Grid><TextBlock Text="주간 Fable" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="FableValue" Text="--%" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold"/></Grid><ProgressBar x:Name="FableBar" Style="{StaticResource UsageProgress}" Margin="0,7,0,0"/></StackPanel>
                </Grid>
                <Grid x:Name="MessagePanel" Grid.Row="1" Visibility="Collapsed" Margin="0,5,0,0">
                    <TextBlock x:Name="MessageText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedTextBrush}"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
