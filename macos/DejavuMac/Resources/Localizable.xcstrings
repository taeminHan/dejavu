    },
    "Turn this off to use Dejavu from the menu bar only." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "끄면 메뉴 막대에서만 Dejavu를 사용할 수 있습니다." } }
