<Window x:Class="ClaudeUsageTray.UsageWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClaudeUsageTray"
        Title="dejavu Widget" Width="452" Height="46" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextHintingMode="Fixed"
        TextOptions.TextRenderingMode="Grayscale">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WidgetTextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource WidgetFontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
        </Style>
    </Window.Resources>
    <Border x:Name="WidgetCard" Style="{StaticResource WidgetCardModern}" CornerRadius="14" Padding="14,11"
            MouseLeftButtonDown="OnWidgetMouseDown" MouseMove="OnWidgetMouseMove"
            MouseLeftButtonUp="OnWidgetMouseUp" MouseRightButtonUp="OnWidgetRightClick">
        <Grid>
            <Rectangle x:Name="ThemeTextureOverlay" IsHitTestVisible="False"
                       Visibility="Collapsed" Opacity="0.16">
                <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="{DynamicResource ThemeGridBrush}" Geometry="M 0,9 L 10,9 10,10 0,10 Z" />
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Grid x:Name="WidgetBody">
            <!-- Small: every metric uses the same 48 px cell and the same 30 px ring. -->
            <Grid x:Name="SmallPanel" Visibility="Collapsed">
                <StackPanel x:Name="SmallProviderPanel" Orientation="Horizontal">
                    <StackPanel x:Name="SmallClaudePanel" Orientation="Horizontal">
                        <StackPanel Width="48">
                            <TextBlock Text="5H" FontSize="9" FontWeight="SemiBold" TextAlignment="Center" Foreground="{DynamicResource WidgetMutedTextBrush}" />
                            <Grid Width="30" Height="30" Margin="0,3,0,0" HorizontalAlignment="Center">
                                <Ellipse x:Name="SmallFiveHourTrack" Stroke="{DynamicResource WidgetTrackBrush}" StrokeThickness="3" />
                                <Path x:Name="SmallFiveHourArc" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <local:OrbitBodyMarker x:Name="SmallFiveHourPlanet" Width="10" Height="10" Body="Moon"
                                                       Fill="{DynamicResource WidgetAccentBrush}" Track="{DynamicResource WidgetBorderBrush}"
                                                       Visibility="Collapsed" />
                                <TextBlock x:Name="SmallFiveHourValue" Text="--%" FontSize="9" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Width="48">
                            <TextBlock Text="주간" FontSize="9" FontWeight="SemiBold" TextAlignment="Center" Foreground="{DynamicResource WidgetMutedTextBrush}" />
                            <Grid Width="30" Height="30" Margin="0,3,0,0" HorizontalAlignment="Center">
                                <Ellipse x:Name="SmallWeeklyTrack" Stroke="{DynamicResource WidgetTrackBrush}" StrokeThickness="3" />
                                <Path x:Name="SmallWeeklyArc" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <local:OrbitBodyMarker x:Name="SmallWeeklyPlanet" Width="10" Height="10" Body="Earth"
                                                       Fill="{DynamicResource WidgetAccentBrush}" Track="{DynamicResource WidgetBorderBrush}"
                                                       Visibility="Collapsed" />
                                <TextBlock x:Name="SmallWeeklyValue" Text="--%" FontSize="9" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Width="48">
                            <TextBlock Text="Fable" FontSize="9" FontWeight="SemiBold" TextAlignment="Center" Foreground="{DynamicResource WidgetMutedTextBrush}" />
                            <Grid Width="30" Height="30" Margin="0,3,0,0" HorizontalAlignment="Center">
                                <Ellipse x:Name="SmallFableTrack" Stroke="{DynamicResource WidgetTrackBrush}" StrokeThickness="3" />
                                <Path x:Name="SmallFableArc" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <local:OrbitBodyMarker x:Name="SmallFablePlanet" Width="10" Height="10" Body="Sun"
                                                       Fill="{DynamicResource WidgetAccentBrush}" Track="{DynamicResource WidgetBorderBrush}"
                                                       Visibility="Collapsed" />
                                <TextBlock x:Name="SmallFableValue" Text="--%" FontSize="9" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="SmallCodexPanel" Width="48" Margin="8,0,0,0">
                        <TextBlock Text="Codex" FontSize="9" FontWeight="SemiBold" TextAlignment="Center" Foreground="{DynamicResource WidgetMutedTextBrush}" />
                        <Grid Width="30" Height="30" Margin="0,3,0,0" HorizontalAlignment="Center">
                            <Ellipse x:Name="SmallCodexTrack" Stroke="{DynamicResource WidgetTrackBrush}" StrokeThickness="3" />
                            <Path x:Name="SmallCodexArc" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <local:OrbitBodyMarker x:Name="SmallCodexPlanet" Width="10" Height="10" Body="Saturn"
                                                   Fill="{DynamicResource WidgetAccentBrush}" Track="{DynamicResource WidgetBorderBrush}"
                                                   Visibility="Collapsed" />
                            <TextBlock x:Name="SmallCodexValue" Text="--%" FontSize="9" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Linear one-row layout: all visible metrics receive an equal-width column. -->
            <Grid x:Name="CompactPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="CompactClaudeFiveColumn" Width="*" />
                    <ColumnDefinition x:Name="CompactClaudeGapOne" Width="10" />
                    <ColumnDefinition x:Name="CompactClaudeWeeklyColumn" Width="*" />
                    <ColumnDefinition x:Name="CompactClaudeGapTwo" Width="10" />
                    <ColumnDefinition x:Name="CompactClaudeFableColumn" Width="*" />
                    <ColumnDefinition x:Name="CompactProviderGap" Width="10" />
                    <ColumnDefinition x:Name="CompactCodexColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="CompactFiveCard" Grid.Column="0">
                <StackPanel x:Name="CompactClaudeFivePanel">
                    <Grid>
                        <TextBlock x:Name="CompactFiveHourLabel" Text="5H" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource WidgetMutedTextBrush}" />
                        <TextBlock x:Name="CompactFiveHourValue" Text="--%" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" />
                    </Grid>
                    <local:UsageProgressBar x:Name="CompactFiveHourBar" Style="{StaticResource UsageProgress}" OrbitBody="Moon" Margin="0,5,0,0" />
                </StackPanel>
                </Border>
                <Border x:Name="CompactWeeklyCard" Grid.Column="2">
                <StackPanel x:Name="CompactClaudeWeeklyPanel">
                    <Grid>
                        <TextBlock x:Name="CompactWeeklyLabel" Text="주간" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource WidgetMutedTextBrush}" />
                        <TextBlock x:Name="CompactWeeklyValue" Text="--%" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" />
                    </Grid>
                    <local:UsageProgressBar x:Name="CompactWeeklyBar" Style="{StaticResource UsageProgress}" OrbitBody="Earth" Margin="0,5,0,0" />
                </StackPanel>
                </Border>
                <Border x:Name="CompactFableCard" Grid.Column="4">
                <StackPanel x:Name="CompactClaudeFablePanel">
                    <Grid>
                        <TextBlock x:Name="CompactFableLabel" Text="Fable" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource WidgetMutedTextBrush}" />
                        <TextBlock x:Name="CompactFableValue" Text="--%" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" />
                    </Grid>
                    <local:UsageProgressBar x:Name="CompactFableBar" Style="{StaticResource UsageProgress}" OrbitBody="Sun" Margin="0,5,0,0" />
                </StackPanel>
                </Border>
                <Border x:Name="CompactCodexCard" Grid.Column="6">
                <StackPanel x:Name="CompactCodexPanel">
                    <Grid>
                        <TextBlock x:Name="CompactCodexLabel" Text="Codex" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource WidgetMutedTextBrush}" />
                        <TextBlock x:Name="CompactCodexValue" Text="--%" HorizontalAlignment="Right"
                                   FontSize="12" FontWeight="SemiBold" />
                    </Grid>
                    <local:UsageProgressBar x:Name="CompactCodexBar" Style="{StaticResource UsageProgress}" OrbitBody="Saturn" Margin="0,5,0,0" />
                </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="CompactMessagePanel" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="CompactMessageDot" Width="6" Height="6" Margin="0,0,8,0" Fill="{DynamicResource AccentBrush}" />
                    <TextBlock x:Name="CompactMessageText" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource WidgetMutedTextBrush}" />
                </StackPanel>
            </Grid>

            <!-- Linear two-row layout: Codex and Claude use the same header/bar rhythm. -->
            <Grid x:Name="ComfortablePanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="CodexRow" Height="Auto" />
                    <RowDefinition x:Name="ClaudeRow" Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="ComfortableCodexCard" Grid.Row="0">
                <StackPanel x:Name="CodexPanel" Margin="0,7,0,0">
                    <Grid>
                        <TextBlock x:Name="CodexLabel" Text="Codex 주간" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource WidgetMutedTextBrush}" />
                        <TextBlock x:Name="CodexValue" Text="--%" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" />
                    </Grid>
                    <local:UsageProgressBar x:Name="CodexBar" Style="{StaticResource UsageProgress}" OrbitBody="Saturn" Margin="0,7,0,0" />
                </StackPanel>
                </Border>
                <Grid x:Name="MetricsPanel" Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="ComfortableGapOne" Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="ComfortableGapTwo" Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ComfortableFiveCard" Grid.Column="0">
                    <StackPanel>
                        <Grid><TextBlock x:Name="FiveHourLabel" Text="5시간" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource WidgetMutedTextBrush}" /><TextBlock x:Name="FiveHourValue" Text="--%" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" /></Grid>
                        <local:UsageProgressBar x:Name="FiveHourBar" Style="{StaticResource UsageProgress}" OrbitBody="Moon" Margin="0,7,0,0" />
                    </StackPanel>
                    </Border>
                    <Border x:Name="ComfortableWeeklyCard" Grid.Column="2">
                    <StackPanel>
                        <Grid><TextBlock x:Name="WeeklyLabel" Text="주간 전체" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource WidgetMutedTextBrush}" /><TextBlock x:Name="WeeklyValue" Text="--%" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" /></Grid>
                        <local:UsageProgressBar x:Name="WeeklyBar" Style="{StaticResource UsageProgress}" OrbitBody="Earth" Margin="0,7,0,0" />
                    </StackPanel>
                    </Border>
                    <Border x:Name="ComfortableFableCard" Grid.Column="4">
                    <StackPanel>
                        <Grid><TextBlock x:Name="FableLabel" Text="주간 Fable" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource WidgetMutedTextBrush}" /><TextBlock x:Name="FableValue" Text="--%" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" /></Grid>
                        <local:UsageProgressBar x:Name="FableBar" Style="{StaticResource UsageProgress}" OrbitBody="Sun" Margin="0,7,0,0" />
                    </StackPanel>
                    </Border>
                </Grid>
                <Grid x:Name="MessagePanel" Grid.Row="0" Visibility="Collapsed" Margin="0,5,0,0">
                    <TextBlock x:Name="MessageText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource WidgetMutedTextBrush}" />
                </Grid>
            </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
